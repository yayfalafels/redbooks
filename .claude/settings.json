{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(cat *.env*)",
      "Bash(cat *.secrets*)",
      "Read(./.env)",
      "Read(./.secrets/**)",
      "Edit(./.env)",
      "Edit(./.secrets/**)",
      "Edit(./data/**)",
      "Write(./.env)",
      "Write(./.secrets/**)",
      "Write(./data/**)"
    ]
  }
}
